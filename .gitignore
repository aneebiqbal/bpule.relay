# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/e2e-results.json

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
benchmark-results/
.neon

# Generated release artifact (see scripts/qa/release-manifest.mjs)
release-manifest.json

# QA release artifacts (generated by qa:release)
qa-artifacts/

# Playwright auth storage (generated by e2e/prospect-global-setup.ts)
e2e/.auth/

# Local QA audit output (screenshots + reports)
artifacts/

# Production PII dump — see docs/PII_GIT_REMEDIATION.md (P0-5, Step 1).
# Never re-add: the directory holds real prospect emails, LinkedIn URLs and
# message bodies. History rewrite is tracked separately in that document.
audit-reports/historical-intelligence/
audit-reports/**/*.csv

# Generated visual-QA captures (multi-viewport screenshots + contact sheets)
screenshots/
feedback-screenshots/

# Local scratch scripts (certification probes, one-off diagnostics)
.tmp/

# Local HTTPS dev certificates (next dev --experimental-https)
certificates/
supabase/aiven/.applied/

# Production database dumps (real prospect PII). Never commit.
supabase/aiven/*.dump
*.dump
