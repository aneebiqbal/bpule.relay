# Disposable-database configuration for live tests and maintenance scripts.
#
#   cp .env.test.example .env.test
#
# `.env.test` is loaded BEFORE `.env.local` by vitest.live.config.mts,
# vitest.smoke.config.mts and scripts/qa/run-live-tests.mjs. It must point only
# at a disposable database (the relay_staging clone, or a local throwaway).
#
# Required opt-in marker. Without it the live suites refuse to start.
RELAY_TEST_DATABASE=1

# NEVER set these to relay_prod* / *production*. The guard rejects them even if
# another variable claims they are staging.
DATABASE_URL=postgres://relay_test:CHANGEME@pg-393a7079-aneebiqbal-bcd9.h.aivencloud.com:22864/relay_staging
SERVICE_DATABASE_URL=postgres://relay_test:CHANGEME@pg-393a7079-aneebiqbal-bcd9.h.aivencloud.com:22864/relay_staging

# Optional extra host fingerprint to reject (comma-separated substrings).
# Note: the Aiven staging clone shares a host with production, so database-NAME
# rejection above is authoritative; use this only for an extra host allowance.
# RELAY_PRODUCTION_SERVICE_FINGERPRINT=prod-host
