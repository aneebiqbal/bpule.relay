# Scout / Relay environment configuration
# Copy to .env.local and fill in what you need. Everything has a safe default.

# --- AI (optional for local demo; without it the deterministic demo path runs) ---
# Model architecture v2 (September 2026): extraction, classification, and
# standard drafting route through a 4-tier chain. Every host is optional; the
# chain just uses whichever hosts have a key configured, so setting only
# GROQ_API_KEY still works exactly as before (degrades to Groq-primary).
#
# Tier 1, primary — DeepSeek V4 Flash, multi-host. Configure at least one of
# these two; both is better (a host retry happens before falling back to a
# different model family in tier 3).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SCOUT_TIER1_MODEL=deepseek-chat
SCOUT_TIER1_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash

# Tier 2 — DeepSeek V4 Pro, escalation only (a lead scoring 10+, or a
# self-check failing on tier 1). Same host keys as tier 1.
SCOUT_TIER2_MODEL=deepseek-reasoner
SCOUT_TIER2_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Tier 3 — Groq, cross-family fallback if every tier 1/2 host fails. Grab a
# free key at console.groq.com.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
SCOUT_TIER3_CHEAP_MODEL=openai/gpt-oss-20b
SCOUT_TIER3_STRONG_MODEL=openai/gpt-oss-120b

# Tier 4 — OpenAI, final safety net. Fires only if tiers 1-3 all fail.
OPENAI_API_KEY=
SCOUT_TIER4_MODEL=gpt-4o-mini

# --- Mode ---
# demo: in-memory store, no Supabase needed (default when the Supabase env vars
#       below are absent). supabase: real Postgres + Auth + RLS store.
# SCOUT_DB=demo

# --- Supabase (only needed for supabase mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: only used by the off-peak cron-triggered routes
# (/api/eval/cron-run, /api/few-shot/refresh's GET) and offline scripts/,
# never by a route that serves a browser request. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Off-peak scheduling (vercel.json crons) ---
# Vercel sets this automatically when cron jobs are added via the dashboard;
# set it yourself if configuring outside the dashboard. Required for the
# cron-triggered routes above to accept a request at all — without it they
# refuse every request rather than run unauthenticated.
CRON_SECRET=

# --- Team rules ---
SCOUT_DAILY_SEND_LIMIT=15