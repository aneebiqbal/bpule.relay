# Scout / Relay environment configuration
# Copy to .env.local and fill in what you need. Everything has a safe default.

# --- AI (optional for local demo; without it the deterministic demo path runs) ---
# All model calls go through Groq. Grab a free key at console.groq.com.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Structuring tasks (extract, classify, calibrate) use the cheap model;
# drafting always uses the strong model. Override either here.
SCOUT_CHEAP_MODEL=openai/gpt-oss-20b
SCOUT_STRONG_MODEL=openai/gpt-oss-120b

# --- Mode ---
# demo: in-memory store, no Supabase needed (default when the Supabase env vars
#       below are absent). supabase: real Postgres + Auth + RLS store.
# SCOUT_DB=demo

# --- Supabase (only needed for supabase mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Team rules ---
SCOUT_DAILY_SEND_LIMIT=15