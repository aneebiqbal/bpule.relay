[Unit]
Description=Relay job discovery worker (bounded incremental ingestion)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/apps/relay-current
EnvironmentFile=/home/deploy/apps/relay/.env.production
# One tick: at most 4 sources, 8s HTTP timeout each, 120s hard ceiling.
# The app route also holds a database lock, so overlapping timers are harmless.
ExecStart=/bin/sh -c 'exec /usr/bin/curl -fsS --max-time 150 -H "Authorization: Bearer $CRON_SECRET" "http://127.0.0.1:3000/api/cron/job-discovery?max=4&timeout=8000"'
TimeoutStartSec=160
MemoryMax=220M
CPUQuota=30%
Nice=10
IOSchedulingClass=idle
# Never crawl the whole internet because a timer fired early.
Restart=no
