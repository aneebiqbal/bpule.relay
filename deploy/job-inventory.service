[Unit]
Description=Relay job inventory reindex (non-destructive feed buckets)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/apps/relay-current
EnvironmentFile=/home/deploy/apps/relay/.env.production
# Recomputes job_inventory_index from the jobs table. Never deletes job rows.
ExecStart=/bin/sh -c 'exec /usr/bin/curl -fsS --max-time 110 -H "Authorization: Bearer $CRON_SECRET" "http://127.0.0.1:3000/api/cron/job-inventory"'
TimeoutStartSec=120
MemoryMax=180M
CPUQuota=25%
Nice=10
IOSchedulingClass=idle
Restart=no
