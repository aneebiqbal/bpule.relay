[Unit]
Description=Relay job verification sweep (bounded employer-source liveness checks)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/apps/relay-current
EnvironmentFile=/home/deploy/apps/relay/.env.production
# Checks a bounded slice of fresh feed listings at their application URL.
# Live -> verified_open, 404/410 -> closed, anything ambiguous -> unchanged.
ExecStart=/bin/sh -c 'exec /usr/bin/curl -fsS --max-time 150 -H "Authorization: Bearer $CRON_SECRET" "http://127.0.0.1:3000/api/cron/job-verification?limit=24&timeout=8000&concurrency=6"'
TimeoutStartSec=160
MemoryMax=140M
CPUQuota=25%
Nice=10
IOSchedulingClass=idle
Restart=no
